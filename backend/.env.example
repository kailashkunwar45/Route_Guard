DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (URL-encode special chars in the password, e.g. @ -> %40)
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/route_db
# Leave unset to fall back to local SQLite.

# Optional sk. token. Free-trial pk. works for Geocoding + Directions if unset.
MAPBOX_SECRET_TOKEN=
# Required for map + (fallback) server Mapbox APIs. Restrict by URL in Mapbox dashboard.
MAPBOX_PUBLIC_TOKEN=pk.your-url-restricted-public-token
USE_FIXTURES=false
