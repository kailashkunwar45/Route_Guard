DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset for local SQLite. Set at deploy time for Postgres.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

MAPBOX_SECRET_TOKEN=pk.or.sk.your-server-token
MAPBOX_PUBLIC_TOKEN=pk.your-url-restricted-public-token
USE_FIXTURES=false
